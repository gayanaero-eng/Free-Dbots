<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">

  <!-- Variables -->
  <variables>
    <variable id="stake">stake</variable>
    <variable id="base_stake">base_stake</variable>
  </variables>

  <!-- Initialize Base Stake -->
  <block type="variables_set" x="50" y="50">
    <field name="VAR" id="base_stake">base_stake</field>
    <value name="VALUE">
      <block type="math_number">
        <field name="NUM">0.5</field>
      </block>
    </value>
    <next>
      <block type="variables_set">
        <field name="VAR" id="stake">stake</field>
        <value name="VALUE">
          <block type="variables_get">
            <field name="VAR" id="base_stake">base_stake</field>
          </block>
        </value>
        <next>
          
          <!-- Trade Block -->
          <block type="trade">
            <field name="SYMBOL">R_100</field>
            <field name="CONTRACT_TYPE">DIGITOVER</field>
            <field name="DURATION">1</field>
            <field name="DURATIONTYPE">t</field>
            <field name="BARRIER">5</field>
            
            <value name="AMOUNT">
              <block type="variables_get">
                <field name="VAR" id="stake">stake</field>
              </block>
            </value>

            <next>
              <!-- On Trade Result -->
              <block type="contract_check_result">
                <field name="CHECK_RESULT">loss</field>
                <statement name="DO">
                  
                  <!-- Martingale -->
                  <block type="variables_set">
                    <field name="VAR" id="stake">stake</field>
                    <value name="VALUE">
                      <block type="math_arithmetic">
                        <field name="OP">MULTIPLY</field>
                        <value name="A">
                          <block type="variables_get">
                            <field name="VAR" id="stake">stake</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number">
                            <field name="NUM">2</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>

                </statement>

                <next>
                  <block type="contract_check_result">
                    <field name="CHECK_RESULT">win</field>
                    <statement name="DO">
                      
                      <!-- Reset stake -->
                      <block type="variables_set">
                        <field name="VAR" id="stake">stake</field>
                        <value name="VALUE">
                          <block type="variables_get">
                            <field name="VAR" id="base_stake">base_stake</field>
                          </block>
                        </value>
                      </block>

                    </statement>
                  </block>
                </next>

              </block>
            </next>
          </block>

        </next>
      </block>
    </next>
  </block>

</xml>
